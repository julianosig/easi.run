#!/bin/bash
# A Codex conversation begun while this chat runs: a file of the account's home until the chat's program ends or the
# place is next settled (runner-settle), when it moves to where every account's chat in the session reads it and a link
# takes its place. Until then it is copied there as it goes, so another account's program can read what this one is
# doing. Every other conversation of the place is there already, written where it is read: Codex's earlier ones
# through their links, and all of Claude Code's, whose directory for the place is one link.
set -u
case "${RUNNER_PLACE:-}" in '' | *[!0-9a-f]*) exit 0 ;; esac
case "${RUNNER_ACCOUNT:-}" in '' | *[!0-9a-f]*) exit 0 ;; esac
[ "${RUNNER_PRODUCT:-}" = codex ] || exit 0
here="$HOME/work/$RUNNER_PLACE"
kept="/run/chat/chats/$RUNNER_PLACE/codex-$RUNNER_ACCOUNT"
# Whether a copy of $3 bytes still is how its file starts, told by the first and the last 4096 of those bytes: a
# conversation is written at its end alone and may be of many gigabytes, which cannot be read whole at every look.
starts() {
  local n=4096
  [ "$3" -lt "$n" ] && n=$3
  cmp -s <(head -c "$n" -- "$1") <(head -c "$n" -- "$2") \
    && cmp -s <(tail -c "+$(($3 - n + 1))" -- "$1" | head -c "$n") <(tail -c "$n" -- "$2")
}
# What the file gained since the last look is added when the copy still is how the file starts; one written anew is
# copied whole, beside its copy, and takes its name in one step.
keep() {
  local is has
  [ -L "$2" ] && return 0
  [ -e "$2" ] && [ ! -f "$2" ] && return 0
  is=$(stat -c %s -- "$1" 2>/dev/null) || return 0
  has=$(stat -c %s -- "$2" 2>/dev/null || echo -1)
  [ "$is" -eq "$has" ] && [ ! "$1" -nt "$2" ] && return 0
  touch -r "$1" /tmp/runner-history.time 2>/dev/null || return 0
  if [ "$has" -gt 0 ] && [ "$is" -ge "$has" ] && starts "$1" "$2" "$has"; then
    if [ "$is" -gt "$has" ]; then
      tail -c "+$((has + 1))" -- "$1" >>"$2" || return 0
    fi
  else
    rm -f -- "$2.part"
    cp -f --remove-destination -- "$1" "$2.part" && mv -f -- "$2.part" "$2" || return 0
  fi
  touch -r /tmp/runner-history.time -- "$2" 2>/dev/null
}
# One at a time with the settling of this account's place (runner-settle), which replaces a copy by its file.
lock="/run/chat/home/.easi-settle-$RUNNER_PLACE.lock"
[ -L "$lock" ] && exit 0
exec 8>>"$lock" || exit 0
while sleep 5; do
  [ -d "$HOME/.codex/sessions" ] || continue
  flock 8
  # Files alone: a conversation that is a link is in the keep itself.
  find "$HOME/.codex/sessions" -type f -name 'rollout-*.jsonl' -mmin -2 2>/dev/null | while IFS= read -r file; do
    head -n 1 -- "$file" | grep -qF "\"cwd\":\"$here\"" || continue
    [ -d "$kept" ] && [ ! -L "$kept" ] || mkdir -p "$kept" 2>/dev/null || continue
    keep "$file" "$kept/${file##*/}"
  done
  flock -u 8
done
