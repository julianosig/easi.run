#!/bin/bash
# What one account has of a session's place, brought to where every account's chat in the session finds it: its files
# into the session's folder, and its conversations into the session's own keep of them, each there once and for all,
# with a link where its program looks for it. Nothing is copied to stay twice, and nothing is written over.
#
#   runner-settle <home> [<account>]
#
# <home> is the account's home as it is without the folder over the place: the chat's own (/run/chat/home), as it
# starts and as its program ends, or another account's (/run/chat/others/<account>), which the controller runs before
# a chat starts so that what the others did there before is there for it (docs/topology.md). With RUNNER_LEAN=1,
# as before a chat starts, Claude Code's conversations there are also cleaned of their screenshots (runner/lean).
#
# Whatever moves is copied whole beside where it goes, takes its name there in one step, and only then leaves the
# home; a move that was cut short is made again, or goes on from what the account's own home says of it. Nothing of a
# home is reached through a link: several accounts' homes may be here at once, and each is its own account's alone.
set -u
home="${1:-}"
account="${2:-${RUNNER_ACCOUNT:-}}"
place="${RUNNER_PLACE:-}"
case "$place" in '' | *[!0-9a-f]*) exit 0 ;; esac
case "$account" in '' | *[!0-9a-f]*) exit 0 ;; esac
# A directory itself, never a link to one.
real() {
  [ -d "$1" ] && [ ! -L "$1" ]
}
real "$home" && [ -O "$home" ] || exit 0
folder=/run/chat/work
keep="/run/chat/chats/$place"
# The path the programs know the folder by, which their conversations are kept by.
here="/home/runner/work/$place"
real "$folder" && real /run/chat/chats || exit 0
# One at a time for an account's place: its chat starting or ending, the copying of what it begins meanwhile
# (runner-history), and another account's chat that brings its things along.
lock="$home/.easi-settle-$place.lock"
[ -L "$lock" ] && exit 0
exec 8>>"$lock" || exit 0
flock 8
said=
say() {
  [ -n "$said" ] && return 0
  said=1
  printf 'Bringing what this account has of this session to where every account finds it...\n'
}
# A directory of this keep's own, never a link someone left there.
own() {
  [ ! -L "$1" ] && { [ -d "$1" ] || mkdir -p "$1" 2>/dev/null; }
}
# $1 whole in the staging directory $2, which is on the volume it goes to: there or not at all.
stage() {
  own "$2" || return 1
  rm -rf -- "${2:?}/${1##*/}"
  cp -a -- "$1" "$2/" && return 0
  rm -rf -- "${2:?}/${1##*/}"
  return 1
}
# Whether every directory on the way from $1 to the file $2 under it (a path from $1) is a directory itself.
within() {
  local dir="$1" rest="$2" part
  while :; do
    part="${rest%%/*}"
    [ "$part" = "$rest" ] && return 0
    dir="$dir/$part"
    real "$dir" || return 1
    rest="${rest#*/}"
  done
}
# What the home says of a move under way, in a file of its own that is no link.
note() {
  rm -f -- "$1" && [ ! -e "$1" ] && [ ! -L "$1" ] && printf '%s' "$2" >"$1"
}

# Its files: what it kept in the place before sessions had a folder. A name the folder has goes under the program's.
free() {
  local under n=1 tag=account
  # Its program: the chat's own, or the one whose things another account's home holds.
  if [ "$home" = /run/chat/home ] && [ -n "${RUNNER_PRODUCT:-}" ]; then
    tag="$RUNNER_PRODUCT"
  elif real "$home/.codex"; then
    tag=codex
  elif real "$home/.claude"; then
    tag=claude
  fi
  if [ ! -e "$folder/$1" ] && [ ! -L "$folder/$1" ]; then
    printf '%s' "$folder/$1"
    return 0
  fi
  while [ "$n" -le 99 ]; do
    under="$folder/from-$tag"
    [ "$n" -gt 1 ] && under="$under-$n"
    if real "$under" || mkdir "$under" 2>/dev/null; then
      if [ ! -e "$under/$1" ] && [ ! -L "$under/$1" ]; then
        printf '%s' "$under/$1"
        return 0
      fi
    fi
    n=$((n + 1))
  done
  return 1
}
files() {
  local before="$home/work/$place" record="$home/work/.easi-moved-$place" staging="$folder/.easi-moving-$account"
  local entry name to try
  real "$home/work" || return 0
  # An entry that had its name in the folder when the move was cut short has only to leave the home.
  if [ -f "$record" ] && [ ! -L "$record" ]; then
    name="$(cat "$record")"
    case "$name" in '' | . | .. | */*) ;; *) real "$before" && rm -rf -- "${before:?}/$name" ;; esac
    rm -f -- "$record"
  fi
  rm -rf -- "$staging"
  real "$before" && [ -O "$before" ] && [ -n "$(ls -A "$before" 2>/dev/null)" ] || return 0
  say
  for entry in "$before"/* "$before"/.[!.]* "$before"/..?*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    name="${entry##*/}"
    if ! stage "$entry" "$staging"; then
      printf 'Not moved, and still in this account'"'"'s home: %s\n' "$name"
      continue
    fi
    # Its name in the folder, taken only if nothing has it: another account's files may be coming in as well.
    try=0
    while [ "$try" -lt 20 ] && { [ -e "$staging/$name" ] || [ -L "$staging/$name" ]; }; do
      try=$((try + 1))
      to="$(free "$name")" || break
      mv -T -n -- "$staging/$name" "$to" 2>/dev/null
    done
    if [ -e "$staging/$name" ] || [ -L "$staging/$name" ]; then
      rm -rf -- "${staging:?}/$name"
      printf 'Not moved, and still in this account'"'"'s home: %s\n' "$name"
      continue
    fi
    note "$record" "$name"
    rm -rf -- "$entry"
    rm -f -- "$record"
  done
  rm -rf -- "$staging"
}

# Claude Code's conversations of the place, and what it noted there: one directory, named by the folder's path. It
# moves into the keep, all of it or none, and a link takes its place, so the program goes on writing where every
# account reads. A move cut short leaves the directory, whole, to be moved again.
claude() {
  local was="$home/.claude/projects/${here//[^a-zA-Z0-9]/-}" to="$keep/claude-$account"
  local staging entry aside="$was.easi-moved"
  # All of it was in the keep when the move was cut short: what is left of it in the home has only to go.
  if real "$aside" && real "$home/.claude" && real "$home/.claude/projects"; then
    [ -e "$was" ] || [ -L "$was" ] || ln -s "$to" "$was"
    rm -rf -- "$aside"
  fi
  [ -L "$was" ] && return 0
  if [ ! -e "$was" ]; then
    # None in the home: the chat's own program goes on in the keep, or starts its first one there.
    [ "$home" = /run/chat/home ] && [ "${RUNNER_PRODUCT:-}" = claude ] || return 0
    [ ! -L "$home/.claude" ] && [ ! -L "$home/.claude/projects" ] || return 0
    own "$keep" && own "$to" && mkdir -p "$home/.claude/projects" && ln -s "$to" "$was"
    return 0
  fi
  real "$home/.claude" && real "$home/.claude/projects" && real "$was" || return 0
  own "$keep" && own "$to" || return 0
  staging="$to/.easi-moving"
  rm -rf -- "$staging"
  own "$staging" || return 0
  say
  if ! cp -a -- "$was"/. "$staging"/; then
    rm -rf -- "$staging"
    printf 'Its conversations here could not be moved, and stay in this account'"'"'s home.\n'
    return 0
  fi
  for entry in "$staging"/* "$staging"/.[!.]* "$staging"/..?*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    rm -rf -- "${to:?}/${entry##*/}"
    mv -T -- "$entry" "$to/${entry##*/}" || return 0
  done
  rm -rf -- "$staging"
  # Out of the way in one step, so that what is removed is never taken for the conversations again.
  mv -T -- "$was" "$aside" && ln -s "$to" "$was" && rm -rf -- "$aside"
}

# Codex's conversations, kept by day, each saying on its first line where it was had: those of the place move into
# the keep, a link taking each one's place. One begun while a chat runs is a file of the home until that chat's
# program ends or the place is next settled (runner-history copies it meanwhile, and its copy gives way here).
codex() {
  local to="$keep/codex-$account" record="$home/.codex/.easi-moved-$place" staging file name told
  real "$home/.codex" && real "$home/.codex/sessions" || return 0
  staging="$to/.easi-moving"
  # A conversation that was in the keep when the move was cut short: its file leaves the home, its link takes its
  # place. The home says which, by its path there.
  if [ -f "$record" ] && [ ! -L "$record" ]; then
    told="$(cat "$record")"
    case "$told" in
      *..* | /*) rm -f -- "$record" ;;
      .codex/sessions/*/rollout-*.jsonl)
        file="$home/$told"
        name="${told##*/}"
        if within "$home" "$told" && [ -f "$to/$name" ] && [ ! -L "$to/$name" ] && [ ! -L "$to" ]; then
          { [ -L "$file" ] || { rm -f -- "$file" && ln -s "$to/$name" "$file"; }; } && rm -f -- "$record"
        else
          rm -f -- "$record"
        fi
        ;;
      *) rm -f -- "$record" ;;
    esac
  fi
  if real "$to"; then
    rm -rf -- "$staging"
    # What a copy that was cut short left.
    rm -f -- "$to"/*.jsonl.part
  fi
  find "$home/.codex/sessions" -type f -name 'rollout-*.jsonl' 2>/dev/null | while IFS= read -r file; do
    head -n 1 -- "$file" | grep -qF "\"cwd\":\"$here\"" || continue
    own "$keep" && own "$to" || continue
    say
    name="${file##*/}"
    stage "$file" "$staging" || continue
    rm -f -- "$to/$name" "$to/$name.part"
    mv -T -- "$staging/$name" "$to/$name" || continue
    note "$record" "${file#"$home"/}"
    rm -f -- "$file" && ln -s "$to/$name" "$file" && rm -f -- "$record"
  done
  real "$staging" && rm -rf -- "$staging"
}

# What an earlier release left in the folder: copies of the conversations, under .chats, every account's. The
# conversations themselves are in the keep now, or come there with their accounts; a copy of one the keep has not is
# kept there, whole or not at all, and the rest goes.
copies() {
  local old="$folder/.chats" dir to entry name
  real "$old" || return 0
  own "$keep" || return 0
  [ -L "$keep/.easi-copies.lock" ] && return 0
  exec 7>>"$keep/.easi-copies.lock" || return 0
  flock 7
  for dir in "$old"/claude-* "$old"/codex-*; do
    real "$dir" || continue
    name="${dir##*/}"
    case "${name#*-}" in '' | *[!0-9a-f]*) continue ;; esac
    to="$keep/$name"
    own "$to" || continue
    for entry in "$dir"/* "$dir"/.[!.]*; do
      [ -e "$entry" ] || [ -L "$entry" ] || continue
      name="${entry##*/}"
      case "$name" in
        *.part) rm -rf -- "$entry" ;;
        *)
          if [ ! -e "$to/$name" ] && [ ! -L "$to/$name" ]; then
            # A staging of its own: an account's conversations may be coming in beside it, by their own.
            stage "$entry" "$to/.easi-copies" || continue
            mv -T -n -- "$to/.easi-copies/$name" "$to/$name" 2>/dev/null
            rm -rf -- "${to:?}/.easi-copies/$name"
          fi
          # Only once the keep has it by that name.
          if [ -e "$to/$name" ] || [ -L "$to/$name" ]; then
            rm -rf -- "$entry"
          fi
          ;;
      esac
    done
    rmdir -- "$to/.easi-copies" 2>/dev/null
    rmdir -- "$dir" 2>/dev/null
  done
  rm -f -- "$old/README.md"
  rmdir -- "$old" 2>/dev/null
  flock -u 7
  exec 7>&-
}

# How the folder says where the conversations are: a link, which whatever empties the folder takes without them.
shown() {
  own "$keep" || return 0
  if [ ! -e "$keep/README.md" ] && [ ! -L "$keep/README.md" ]; then
    cat >"$keep/README.md" <<'ABOUT'
# Conversations of this session's chats

Every chat account that works in this session works in the same folder, and its conversations there are kept here,
each account's in a directory of its own, `<program>-<account>`:

- Each `.jsonl` file is one conversation, in its program's own format, one JSON object per line. The file changed
  last is the latest conversation.
- `memory/` is what Claude Code noted about the folder.

These are the conversations themselves, which their programs go on writing: read them, and leave them as they are.
ABOUT
  fi
  [ -e "$folder/.chats" ] || [ -L "$folder/.chats" ] || ln -s "$keep" "$folder/.chats"
}

# The conversations a Claude Code account has in the keep, without the pictures it wrote into them (runner/lean): as
# the place is settled before a chat starts, never as a chat's program ends, which may still be writing.
lean() {
  [ "${RUNNER_LEAN:-}" = 1 ] || return 0
  real "$keep" || return 0
  /usr/local/bin/runner-lean "$account" "$keep" || true
}

files
claude
codex
copies
shown
lean
exit 0
