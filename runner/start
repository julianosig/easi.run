#!/bin/sh
# A chat's container: the forwarders to its proxy and its files, and its one program on a terminal that outlives every viewer, until
# that program ends. The controller's only execs here are runner-attach and runner-usage.
set -eu
# The same image, before a chat starts, for the other accounts: what each has of this session's place is brought to
# where every account's chat finds it (runner/settle). Each one's home is at /run/chat/others/<account>.
if [ "${RUNNER_SETTLE:-}" = 1 ]; then
  for home in /run/chat/others/*; do
    [ -d "$home" ] || continue
    /usr/local/bin/runner-settle "$home" "${home##*/}" || true
  done
  exit 0
fi
socat TCP-LISTEN:3128,bind=127.0.0.1,fork,reuseaddr UNIX-CONNECT:/run/chat/proxy/proxy.sock &
# Its files' URLs, which the admin answers at its own socket, wherever the admin itself is reached from.
socat TCP-LISTEN:3129,bind=127.0.0.1,fork,reuseaddr UNIX-CONNECT:/run/chat/mcp/files.sock &
tmux -f /etc/runner/tmux.conf new-session -d -s chat -x 120 -y 30 /usr/local/bin/runner-chat
# A conversation it begins meanwhile, copied to where the next account's program reads it (runner/history).
# In a group of its own, so that all of it can be ended.
setsid /usr/local/bin/runner-history &
history=$!
while tmux has-session -t chat 2>/dev/null; do
  sleep 1
done
# What it began meanwhile moves to where every account reads it, the copying of it ended first.
kill -- "-$history" 2>/dev/null || true
wait "$history" 2>/dev/null || true
n=0
while kill -0 -- "-$history" 2>/dev/null && [ "$n" -lt 100 ]; do
  n=$((n + 1))
  sleep 0.1
done
/usr/local/bin/runner-settle /run/chat/home >/dev/null 2>&1 || true
