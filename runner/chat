#!/bin/bash
# The one program of a chat's terminal, and nothing else: the vendor's own, as its own installer puts it in this
# account's home, unmodified, signing in by its own flow. When it ends, the chat ends. The MCP server it is told of
# reaches this session's browser alone, through the socket the admin serves for this chat. It works in this session's own
# place in the home (RUNNER_PLACE), where it opens the conversation it last had there.
set -u
stop() {
  printf '\n%s\nPress Enter to close.\n' "$1"
  read -r _
  exit 1
}
cd "$HOME" || stop "This account's home is not available."
case "$RUNNER_PLACE" in
  '' | *[!0-9a-f]*) stop "This chat has no place of its own." ;;
esac
mkdir -p "work/$RUNNER_PLACE" && cd "work/$RUNNER_PLACE" || stop "This account's home is not writable."
bin="$HOME/.local/bin/$RUNNER_PRODUCT"
# What its installer needs from here on is the proxy.
n=0
until [ -S /run/chat/proxy/proxy.sock ]; do
  n=$((n + 1))
  [ "$n" -lt 50 ] || stop "The chat's proxy did not start."
  sleep 0.2
done
# Its vendor's installer, with no terminal of its own to ask questions on: it only prints here. One at a time in this
# home: another chat of this account may be at it, and this one then finds it done.
get() {
  stale || return 0
  printf 'Getting %s from its official installer...\n' "$1"
  exec 8>"$HOME/.install.lock"
  flock 8
  if stale; then
    curl -fsSL "$2" -o /tmp/install.sh && setsid -w "$3" /tmp/install.sh </dev/null 8>&- || printf 'The installer failed.\n'
  fi
  exec 8>&-
  [ -x "$bin" ] || stop "$1 could not be installed."
}
# How many processes this container's memory limit has ended so far.
oom_kills() { sed -n 's/^oom_kill //p' /sys/fs/cgroup/memory.events 2>/dev/null; }
# Runs the program (once) until the person ends it. One that the memory limit ended opens the same conversation again.
# Its first start in a home, or the first after an update, may migrate its databases with no lock between processes: two
# chats starting together can collide there, and the one that loses exits at once, with the next start finding it done.
# Otherwise a program that ran for a while ended by choice or for good.
run() {
  local quick=0 began kills status
  while :; do
    began=$SECONDS
    kills="$(oom_kills)"
    once
    status=$?
    # Killed outright while the limit ended something: one of its commands alone leaves it running.
    if [ "$status" -eq 137 ] && [ "$(oom_kills)" != "$kills" ]; then
      printf '\n%s ran out of this chat'"'"'s memory. Opening the same conversation again...\n' "$1"
    elif [ "$status" -eq 0 ] || [ $((SECONDS - began)) -ge 10 ]; then
      exit "$status"
    fi
    if [ $((SECONDS - began)) -lt 10 ]; then
      quick=$((quick + 1))
      [ "$quick" -lt 3 ] || stop "$1 could not start."
    else
      quick=0
    fi
    sleep 1
  done
}
case "$RUNNER_PRODUCT" in
  codex)
    # Its installer is also how it updates.
    stale() { [ ! -x "$bin" ] || [ -n "$(find -L "$bin" -mtime +7 2>/dev/null)" ]; }
    get Codex https://chatgpt.com/codex/install.sh sh
    # Its own sandbox needs user namespaces, which this container refuses, so it could run no command at all, and it
    # asks before none: a chat that comes back with its session (the admin stopped, then started again) goes on with
    # its conversation with nobody at its terminal to answer. This container is what bounds its commands
    # (docs/security.md). With no conversation here yet, it starts one.
    once() {
      codex resume --last \
        -c 'cli_auth_credentials_store="file"' \
        -c 'sandbox_mode="danger-full-access"' \
        -c 'approval_policy="never"' \
        -c 'mcp_servers.easi.command="/usr/local/bin/runner-mcp"' \
        -c 'mcp_servers.easi.default_tools_approval_mode="approve"'
    }
    run Codex
    ;;
  claude)
    # It updates itself.
    stale() { [ ! -x "$bin" ]; }
    get 'Claude Code' https://claude.ai/install.sh bash
    once() {
      # Where it keeps this place's conversations; --continue with none there would only fail.
      if compgen -G "$HOME/.claude/projects/${PWD//[^a-zA-Z0-9]/-}/*.jsonl" >/dev/null; then
        set -- --continue
      fi
      # It asks before no command or file change, nor before starting so: as Codex above, it goes on with nobody at
      # its terminal, and this container is what bounds it. It runs as this container's own user, never as root, which
      # it would refuse.
      claude "$@" --dangerously-skip-permissions --settings '{"skipDangerousModePermissionPrompt":true}' \
        --mcp-config /etc/runner/claude-mcp.json --allowedTools mcp__easi
    }
    run 'Claude Code'
    ;;
  *) stop "Unknown program: $RUNNER_PRODUCT" ;;
esac
