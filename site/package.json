{
  "name": "easi-run-site",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "The landing page: a static Svelte page styled with Tailwind.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5180 --strictPort",
    "check": "node scripts/changelog.mjs && node ../i18n/sync.mjs --check && node ../i18n/sync.mjs --messages=src/docs/messages --types-out=src/docs/keys.ts --check && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "build": "npm run check && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5181 --strictPort"
  },
  "devDependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "highlight.js": "11.12.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0"
  }
}
