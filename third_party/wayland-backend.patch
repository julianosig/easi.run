+    /// Insert given object for an id the peer allocated, which must be in the client namespace
+    ///
+    /// Fails like `insert_at`, and also for an id of the server namespace, which a client may never allocate.
+    /// (easi.run patch: upstream 0.3.17 accepts such ids from a client, which lets it grow the server-object
+    /// store without bound.)
+    pub fn insert_at_client_id(&mut self, id: u32, object: Object<Data>) -> Result<(), ()> {
+        if id >= SERVER_ID_LIMIT {
+            Err(())
+        } else {
+            self.insert_at(id, object)
+        }
+    }
+
